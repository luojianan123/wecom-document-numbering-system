APP_ENV=development
APP_NAME=文件编号系统
DATABASE_URL=postgresql+psycopg://filecode:filecode@db:5432/filecode
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_MAX_AGE_SECONDS=28800
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# 企业微信扫码登录：本地开发用 mock，联调和生产使用 live
WECOM_AUTH_MODE=mock
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
WECOM_ADMIN_USER_IDS=

# AI：rules 为本地规则修名，openai_compatible 为企业模型接口
AI_MODE=rules
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

RULE_FILE_PATH=/app/rules/编号规则采集模板.yaml
ABBREVIATION_FILE_PATH=/app/rules/文件简号.xlsx
AUTO_CREATE_TABLES=true
